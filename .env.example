# The web process must use a restricted login that inherits mndf_pms_runtime.
NODE_ENV=production
DATABASE_URL=postgresql://performance_tracker_app:replace-runtime-password@127.0.0.1:5432/performance_tracker
# At least 32 random characters. Rotate through a controlled session invalidation procedure.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# At least 32 random characters. Used only by the tenant-scoped deadline worker.
GRIEVANCE_CRON_SECRET=replace-with-at-least-32-random-characters
# Private directory outside the public web root. The service account must be its only writer.
EVIDENCE_STORAGE_ROOT=C:\\mndf-pms-private\\evidence
# Infected or integrity-failed objects are moved here and must never be web-accessible.
EVIDENCE_QUARANTINE_ROOT=C:\\mndf-pms-private\\quarantine
# Shared only with the malware scanner callback. Generate at least 32 random characters.
EVIDENCE_SCANNER_SECRET=replace-with-at-least-32-random-characters
# Shared only with the loopback operations monitor. It must differ from every other secret.
OPERATIONS_MONITOR_SECRET=replace-with-at-least-32-random-characters
# HMAC signing key for audit export manifests. Store only in protected operations configuration.
AUDIT_EXPORT_HMAC_KEY=replace-with-at-least-32-random-characters
# A database role with tenant-scoped audit SELECT and verify_audit_hash_chain execution only.
AUDIT_DATABASE_URL=postgresql://audit_exporter:replace-audit-password@127.0.0.1:5432/performance_tracker
HOSTNAME=127.0.0.1
PORT=3100
