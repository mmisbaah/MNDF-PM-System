DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/mndf_pms
# At least 32 random characters. Rotate through a controlled session invalidation procedure.
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# At least 32 random characters. Used only by the tenant-scoped deadline worker.
GRIEVANCE_CRON_SECRET=replace-with-at-least-32-random-characters
# Private directory outside the public web root. The service account must be its only writer.
EVIDENCE_STORAGE_ROOT=C:\\mndf-pms-private\\evidence
# Shared only with the malware scanner callback. Generate at least 32 random characters.
EVIDENCE_SCANNER_SECRET=replace-with-at-least-32-random-characters
