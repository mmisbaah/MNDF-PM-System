{
  "format": "performance-tracker-release-branch-policy-v1",
  "repository": "mmisbaah/MNDF-PM-System",
  "branch": "main",
  "requiredStatusChecks": [
    "code-gate",
    "windows-deployment-guards",
    "Analyze JavaScript and TypeScript"
